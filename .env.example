# Copy to .env and fill in the blanks:  cp .env.example .env
# Every variable below is actually read somewhere in the code — nothing here is decorative.

# --- Postgres (consumed by docker-compose.dev.yml / docker-compose.yml) ---
POSTGRES_USER=saveit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=saveit

# --- Prisma ---
# prisma/schema.prisma:4. Required at RUNTIME *and* during `next build` —
# app/page.tsx imports lib/auth, which constructs a PrismaClient at module scope.
DATABASE_URL=postgresql://saveit:change-me@localhost:5432/saveit?schema=public

# Tests only (vitest.config.mts). MUST be a different database than DATABASE_URL:
# tests/setup.ts TRUNCATEs every table in beforeEach.
TEST_DATABASE_URL=postgresql://saveit:change-me@localhost:5432/saveit_test?schema=public

# --- better-auth ---
# lib/auth.ts:9. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# lib/auth.ts:8. Comma-separated list of trusted origins.
BETTER_AUTH_TRUSTED_URLS=http://localhost:33449

# --- App ---
# lib/auth-client.ts:5, read at RUNTIME via next-runtime-env (<PublicEnvScript/> in
# app/layout.tsx:22). Pass it as a container env var — never as a Docker build arg.
NEXT_PUBLIC_API_URL=http://localhost:33449
# Host port published by docker-compose.yml; the container always listens on 33449.
APP_PORT=33449
# lib/logger.ts:3 — trace|debug|info|warn|error|fatal
LOG_LEVEL=info
